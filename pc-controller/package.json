{
  "name": "pc-controller",
  "version": "1.0.0",
  "description": "Agente de control de PC para renta (tiempo real, bloqueo, desbloqueo)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "pack": "electron-builder --dir --win --x64"
  },
  "author": "GC",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "electron-store": "^8.1.0",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "electron": "^26.4.0",
    "electron-builder": "^24.7.0"
  },
  "build": {
    "appId": "com.gcweb.pc-controller",
    "productName": "GC Web Controller Devices",
    "win": {
      "target": "nsis"
    },
    "files": ["**/*"],
    "extraResources": []
  }
}
